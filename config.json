{"$schema": "../skill-config-schema.json", "excludeDirs": ["node_modules", ".git", "dist", "build", ".cache", ".next", ".nuxt", "coverage", ".output", ".turbo", "vendor", "__pycache__", ".pytest_cache", "target", "*.min.js", "*.min.css"], "aliases": {"comment": "自定义别名扩展，将自动合并到内置别名映射表中", "examples": {"审批": ["approval", "workflow", "flow"], "报表": ["report", "chart", "dashboard", "statistics", "stat"]}}, "modules": {"comment": "自定义模块分组，用于更精准的定位和展示", "groups": [{"name": "frontend", "label": "前端模块", "paths": ["src/", "web/", "client/", "app/"], "description": "前端相关代码"}, {"name": "backend", "label": "后端模块", "paths": ["server/", "api/", "services/"], "description": "后端服务相关代码"}, {"name": "shared", "label": "共享模块", "paths": ["common/", "shared/", "utils/", "lib/"], "description": "前后端共享的工具和公共代码"}, {"name": "config", "label": "配置模块", "paths": ["config/", "configs/", ".env*"], "description": "配置文件和环境变量"}]}, "searchPriority": {"comment": "自定义搜索目录优先级，将覆盖默认的动态搜索策略", "frontend": {"priority": ["views", "pages", "screens", "components", "router", "routes", "store", "stores", "api", "services", "config"], "extensions": [".vue", ".jsx", ".tsx", ".js", ".ts"]}, "backend": {"priority": ["controllers", "handlers", "services", "models", "repositories", "dao", "entities", "routes", "config", "resources"], "extensions": [".java", ".go", ".py", ".ts", ".js", ".rs"]}, "general": {"comment": "通用搜索配置，适用于无法识别项目类型的情况", "maxResults": 20, "timeoutMs": 10000, "fuzzyMatchThreshold": 0.6}}}